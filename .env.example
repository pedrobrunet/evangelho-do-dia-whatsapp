# Copie para .env (nao versionado) e preencha com os seus valores.
# Nenhum destes valores deve ir para o repositorio.

# --- Aplicacao ---
SERVER_PORT=8081
APP_TIMEZONE=America/Sao_Paulo

# Token exigido no header X-Admin-Token para acessar /api/**.
# Deixe vazio SOMENTE em uso local. Gere um valor forte, por exemplo:
#   openssl rand -hex 32
ADMIN_TOKEN=

# --- Integracao WhatsApp ---
# EVOLUTION ou WEBHOOK
WHATSAPP_PROVIDER=EVOLUTION
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_INSTANCE=minha-instancia
WHATSAPP_API_KEY=

# true = nao chama a API externa, apenas escreve no log (recomendado para testes)
WHATSAPP_SIMULAR=true

# --- Fontes de conteudo (opcional) ---
LITURGIA_URL=https://liturgiadiaria.cancaonova.com/pp/
LITURGIA_API_URL=https://liturgia.up.railway.app/v2/
