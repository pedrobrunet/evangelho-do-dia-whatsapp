# Copie para .env (nao versionado) e preencha com os seus valores.
# Nenhum destes valores deve ir para o repositorio.

# --- Aplicacao ---
SERVER_PORT=8081
APP_TIMEZONE=America/Sao_Paulo

# Token exigido no header X-Admin-Token para acessar /api/**.
# Deixe vazio SOMENTE em uso local. Gere um valor forte, por exemplo:
#   openssl rand -hex 32
ADMIN_TOKEN=

# --- Integracao WhatsApp ---
# EVOLUTION (pareamento por QR code pelo painel) ou WEBHOOK (POST generico)
WHATSAPP_PROVIDER=EVOLUTION
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_INSTANCE=evangelho

# Chave da Evolution API. O mesmo valor e usado pelo docker-compose.yml.
# Gere um valor forte, por exemplo:  openssl rand -hex 32
WHATSAPP_API_KEY=

# true  = nao chama a API externa; devolve conexao e grupos ficticios (para testar a interface)
# false = pareamento e envio reais, exigem a Evolution API no ar
WHATSAPP_SIMULAR=true

# --- Fontes de conteudo (opcional) ---
LITURGIA_URL=https://liturgiadiaria.cancaonova.com/pp/
LITURGIA_API_URL=https://liturgia.up.railway.app/v2/
